# =============================================================================
# SnapShop 后端环境变量模板
# 使用方式: cp .env.example .env 然后编辑 .env 填入实际值
# =============================================================================

# ---- App ----
APP_NAME=SnapShop API
DEBUG=true

# ---- Database ----
# 本地开发（SQLite，无需 Docker）
DATABASE_URL=sqlite+aiosqlite:///./snapshop.db
# 生产环境（PostgreSQL via Docker Compose）
# DATABASE_URL=postgresql+asyncpg://snapshop:你的密码@localhost:5432/snapshop
POSTGRES_USER=snapshop
POSTGRES_PASSWORD=请设置你的数据库密码
POSTGRES_DB=snapshop

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- MinIO / 对象存储 ----
# 本地 Docker MinIO
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=你的MinIO用户名
# MINIO_SECRET_KEY=你的MinIO密码
# 火山引擎 TOS（生产环境）
MINIO_ENDPOINT=tos-cn-beijing.volces.com
MINIO_ACCESS_KEY=你的TOS_Access_Key
MINIO_SECRET_KEY=你的TOS_Secret_Key
MINIO_BUCKET=snapshop-images
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=请设置你的MinIO密码

# ---- JWT ----
# 生产环境必须设置为强随机密钥，否则应用拒绝启动
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=请生成并填入JWT密钥

# ---- Ark 火山方舟 AI ----
# 比赛专用资源，填写你的 API Key 和 Endpoint ID
ARK_API_KEY=你的火山方舟API_Key
ARK_VLM_ENDPOINT_ID=你的VLM端点ID
ARK_LLM_ENDPOINT_ID=你的LLM端点ID
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ---- AI 模式 ----
# true=mock模式(无需API Key), false=真实AI推理
AI_MOCK_MODE=false

# ---- 拼多多开放平台（可选，留空使用Mock数据）----
PDD_CLIENT_ID=你的拼多多Client_ID
PDD_CLIENT_SECRET=你的拼多多Client_Secret
PDD_ACCESS_TOKEN=
PDD_PID=你的拼多多PID
PDD_MEDIA_ID=你的拼多多媒体ID
PDD_CUSTOM_PARAMETERS={"uid":"snapshop_search"}
PDD_API_URL=https://gw-api.pinduoduo.com/api/router

# ---- 京东联盟开放平台（可选，留空使用Mock数据）----
JD_APP_KEY=你的京东App_Key
JD_APP_SECRET=你的京东App_Secret
JD_ACCESS_TOKEN=
JD_SITE_ID=你的京东站点ID
JD_API_URL=https://router.jd.com/api

# ---- 限流 ----
RECOGNIZE_RATE_LIMIT=10
FILTER_RATE_LIMIT=30
