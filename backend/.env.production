# SnapShop 生产环境配置 — 复制此文件为 .env 并填入真实值后部署

# App
APP_NAME=SnapShop API
DEBUG=false
ALLOWED_ORIGINS=*

# Database
POSTGRES_USER=snapshop
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=snapshop
# Docker 内会被 docker-compose.prod.yml 覆盖为 @db:5432，此处为本地调试用
DATABASE_URL=postgresql+asyncpg://snapshop:CHANGE_ME_postgres_password@db:5432/snapshop

# Redis
# Redis — Docker 内会被覆盖为 @redis:6379
REDIS_URL=redis://redis:6379/0

# MinIO / TOS
MINIO_ROOT_USER=snapshop_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
# MinIO — Docker 内会被覆盖为 minio:9000
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=snapshop_admin
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
MINIO_BUCKET=snapshop-images

# JWT — 生产环境必须设置为强随机密钥，否则应用将拒绝启动
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE_ME_generate_with_python_secrets

# Ark (火山方舟) — 比赛专用 AI 推理资源
ARK_API_KEY=你的火山方舟_API_Key
ARK_VLM_ENDPOINT_ID=ep-xxxxxx
ARK_LLM_ENDPOINT_ID=ep-xxxxxx
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# AI — false=真实 AI 推理; true=Mock 降级模式
AI_MOCK_MODE=false

# Rate limiting
RECOGNIZE_RATE_LIMIT=10
FILTER_RATE_LIMIT=30
