# App
APP_NAME=SnapShop API
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
POSTGRES_USER=snapshop
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=snapshop
DATABASE_URL=postgresql+asyncpg://snapshop:your_secure_postgres_password_here@localhost:5432/snapshop

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / TOS
MINIO_ROOT_USER=your_secure_minio_username_here
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_secure_minio_username_here
MINIO_SECRET_KEY=your_secure_minio_password_here
MINIO_BUCKET=snapshop-images

# JWT — 生产环境必须设置为强随机密钥，否则应用将拒绝启动
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-secret-key-at-least-32-chars-please-change-in-production

# Ark (火山方舟) - optional, can be empty for mock mode
ARK_API_KEY=
ARK_VLM_ENDPOINT_ID=
ARK_LLM_ENDPOINT_ID=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# AI fallback
AI_MOCK_MODE=true

# Rate limiting
RECOGNIZE_RATE_LIMIT=10
FILTER_RATE_LIMIT=30
