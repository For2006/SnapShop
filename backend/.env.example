# App
APP_NAME=SnapShop API
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/snapshop

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / TOS
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=snapshop-images

# JWT
JWT_SECRET=your-secret-key-at-least-32-chars

# Ark (火山方舟) - optional, can be empty for mock mode
ARK_API_KEY=
ARK_VLM_ENDPOINT_ID=
ARK_LLM_ENDPOINT_ID=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# AI fallback
AI_MOCK_MODE=true

# Rate limiting
RECOGNIZE_RATE_LIMIT=10
FILTER_RATE_LIMIT=30
